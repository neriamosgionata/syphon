{
  "name": "syphon-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build --production",
    "start": "node server.js",
    "lint": "eslint . --ext=.ts",
    "test": "node -r @adonisjs/assembler/build/register tests/bootstrap.ts unit && node -r @adonisjs/assembler/build/register tests/bootstrap.ts functional",
    "test:unit": "node -r @adonisjs/assembler/build/register tests/bootstrap.ts unit",
    "test:functional": "node -r @adonisjs/assembler/build/register tests/bootstrap.ts functional",
    "worker": "node ace queue:listen"
  },
  "dependencies": {
    "@adonisjs/core": "5.9.0",
    "@adonisjs/lucid": "18.4.2",
    "@adonisjs/redis": "7.3.4",
    "@adonisjs/repl": "3.1.11",
    "@google-cloud/bigquery": "^8.1.1",
    "@stoqey/ib": "1.5.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "5.70.4",
    "cheerio": "1.0.0",
    "luxon": "3.7.2",
    "mysql2": "3.19.0",
    "natural": "8.1.1",
    "node-cron": "4.2.1",
    "proxy-agent": "6.4.0",
    "reflect-metadata": "0.2.2",
    "rss-parser": "3.13.0",
    "source-map-support": "0.5.21",
    "ws": "^8.21.1",
    "yahoo-finance2": "2.13.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "5.9.6",
    "@japa/api-client": "^1.4.4",
    "@japa/assert": "^1.4.1",
    "@japa/runner": "^2.5.1",
    "@japa/spec-reporter": "^1.3.3",
    "@types/luxon": "3.4.2",
    "@types/node": "22.15.3",
    "@types/node-cron": "3.0.11",
    "@types/ws": "^8.18.1",
    "adonis-preset-ts": "2.1.0",
    "get-port": "^5.1.1",
    "pino-pretty": "13.0.0",
    "supertest": "^6.3.3",
    "typescript": "5.9.3"
  }
}

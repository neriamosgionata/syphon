{
  "name": "syphon-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ace serve --watch",
    "build": "node ace build",
    "start": "node bin/server.js",
    "test": "TEST_SUITE=unit node ace test && TEST_SUITE=functional node ace test",
    "test:unit": "TEST_SUITE=unit node ace test",
    "test:functional": "TEST_SUITE=functional node ace test",
    "worker": "node ace queue:listen"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#config/*": "./config/*.js",
    "#database/*": "./database/*.js",
    "#providers/*": "./providers/*.js",
    "#start/*": "./start/*.js",
    "#commands/*": "./commands/*.js",
    "#tests/*": "./tests/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "dependencies": {
    "@adonisjs/core": "^7.4.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/repl": "^5.0.0",
    "@google-cloud/bigquery": "^9.0.2",
    "@stoqey/ib": "^1.6.7",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.1.2",
    "cheerio": "^1.2.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.23.3",
    "natural": "^8.1.1",
    "node-cron": "^4.6.0",
    "proxy-agent": "^8.0.2",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "source-map-support": "^0.5.21",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.4",
    "@types/node": "~26.2.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  }
}
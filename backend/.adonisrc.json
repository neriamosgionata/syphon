{
  "typescript": true,
  "commands": [
    "./commands",
    "@adonisjs/core/build/commands",
    "@adonisjs/lucid/build/commands",
    "@adonisjs/repl/build/commands"
  ],
  "exceptionHandlerNamespace": "App/Exceptions/Handler",
  "aliases": {
    "App": "app",
    "Config": "config",
    "Contracts": "contracts",
    "Database": "database",
    "Providers": "providers"
  },
  "preloads": [
    "./start/routes",
    "./start/kernel",
    {
      "file": "./start/jobs",
      "environment": ["web"]
    },
    {
      "file": "./start/logForwarder",
      "environment": ["web"]
    }
  ],
  "providers": [
    "./providers/AppProvider",
    "@adonisjs/core",
    "@adonisjs/lucid",
    "@adonisjs/redis",
    "@adonisjs/repl"
  ],
  "aceProviders": [
    "@adonisjs/lucid"
  ],
  "namespaces": {
    "models": "App/Models",
    "httpControllers": "App/Controllers/Http"
  }
}
